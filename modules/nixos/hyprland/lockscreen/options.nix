{ lib, pkgs, ... }:
{
  options.my.desktop.hyprland.lockscreen = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable screen locker (SUPER+L).";
    };
    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.swaylock;
      defaultText = lib.literalExpression "pkgs.swaylock";
      example = lib.literalExpression "pkgs.hyprlock";
      description = "Lock screen package (swaylock or hyprlock).";
    };
    useHyprlock = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Use hyprlock instead of swaylock. Sets package to pkgs.hyprlock and generates hyprlock.conf.";
    };

    wallpaper = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = ''
          Draw the current wallpapers on the hyprlock lock screen instead of a
          flat palette colour. Reads `wallpapers.resolvedImages`, so the
          per-output crops generated by `wallpapers.span` are shown on the
          matching monitors. hyprlock only — ignored (palette colour) when
          `useHyprlock = false`, and video span segments are not supported.
        '';
      };

      blurPasses = lib.mkOption {
        type = lib.types.ints.between 0 8;
        default = 2;
        description = "hyprlock background blur passes (0 disables blur).";
      };

      blurSize = lib.mkOption {
        type = lib.types.ints.between 1 64;
        default = 8;
        description = "hyprlock background blur size.";
      };

      brightness = lib.mkOption {
        type = lib.types.numbers.between 0.0 1.0;
        default = 0.85;
        description = "hyprlock background brightness (1.0 = unchanged, lower = dimmer).";
      };
    };
  };
}
