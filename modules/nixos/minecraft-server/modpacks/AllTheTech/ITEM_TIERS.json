  },
  "A": {
   "label": "Strong upgrade / rare drop",
   "criteria": "Major combat/mobility/utility win; the mod itself treats it as rare (low pool weight) or it's a mid-game power spike.",
   "loot_guidance": "Rare pool: weight 2-5 in mid/late structure chests, boss drops, or mimicked loot."
  },
  "B": {
   "label": "Solid situational",
   "criteria": "Genuinely useful in a niche (biome, slotted task, playstyle). Common-quality drop, strong when it applies.",
   "loot_guidance": "Common pool: weight 6-10 in general loot; safe in campsites/dungeons."
  },
  "C": {
   "label": "Niche convenience",
   "criteria": "Flavor-adjacent or weak-utility; nice to find, not progression-relevant. Safe early.",
   "loot_guidance": "Filler weight in any early chest; never gated."
  },
  "D": {
   "label": "Common consumable/material",
   "criteria": "Consumables, crafting bits, or cosmetic blocks. No loot-table gate warranted.",
   "loot_guidance": "Unlimited filler; weights in generic supply pools."
  },
  "F": {
   "label": "Novelty / joke",
   "criteria": "April-Fools, easter-egg, or pure-gag items. Fine as rare curiosities, never progression.",
   "loot_guidance": "April-Fools window or creative only; exclude from normal pools."
  }
