		"C3D4E5F607182078": {
			description: "Craft a Diamond Drill head. Faster mining machines for your ore excavation rig — or push further to netherite drill heads."
			name: "Diamond Drill Head"
		}
		"C3D4E5F607182079": {
			description: "Craft an Item Transmitter. Skip the belts entirely: wirelessly beam items (and fluids/energy with the other transmitters) across your base."
			name: "Ender Transmission"
		}
		"C3D4E5F60718207A": {
			description: "Build a Hypertube Entrance. Player-scale hyper-fast transport tubes — zip between your factories at breakneck speed."
			name: "Hypertubes"
		}
		"C3D4E5F60718207B": {
			description: "Craft an Optical Source. Beam rotational energy through light for truly wireless power distribution across long distances."
			name: "Optical Power"
		}
		"C3D4E5F60718207C": {
			description: "Assemble a Create Nuclear Reactor Controller — melt uranium rods in a reactor to generate massive mechanical power. Wear radiation protection!"
			name: "Create Nuclear Reactor"
		}
		"C3D4E5F60718207D": {
			description: "Fuel the reactor: craft and insert uranium rods (plus graphite) into the reactor input to keep the mechanical power flowing."
			name: "Uranium Fuel Rods"
		}
		"C3D4E5F60718207E": {
			description: "Set up renewable production of brass, diamonds and netherite through Create's renewable recipes — endgame resources without endless strip-mining."
			name: "Renewable Resources"
		}
		"C3D4E5F60718207F": {
			description: "Automate Create: Ultimate Factory's advanced recipes — 30+ balanced automation recipes that turn every production line into a mega-factory."
			name: "Ultimate Factory"
		}
		"022CA60ED7920A5D": {
			description: "Follow the quest book from left to right — every quest unlocks the next. Complete Getting Started to open the tech chapters."
			name: "Welcome to AllTheTech"
		}
