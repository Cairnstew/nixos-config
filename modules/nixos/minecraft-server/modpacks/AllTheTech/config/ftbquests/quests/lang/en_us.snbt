{
	quest: {
		"019105FA82C64A8E": {
			description: "Gather redstone to power Create shafts, copper for wiring, and zinc for andesite alloy. These three resources are the foundation of ALL tech trees."
			name: "Redstone Gathering"
		}
		"019105FA82C64A8F": {
			description: "Craft andesite alloy — the first Create component. Mekanism will use it for enriched iron, and AE2 needs it for processors."
			name: "Andesite Alloy"
		}
		"019105FA82C64A90": {
			description: "Craft brass ingots using Create's mixing. Brass is essential for Create's precision mechanisms AND Mekanism's advanced circuits."
			name: "Brass Ingots"
		}
		"019105FA82C64A91": {
			description: "Create enriched iron for Mekanism. This same ore doubling process feeds both Mekanism machines AND Create's kinetic processing."
			name: "Enriched Iron"
		}
		"019105FA82C64A92": {
			description: "Craft a shaft — Create's rotational transfer component. This same shaft powers Mekanism's wind turbines and AE2's energy acceptors."
			name: "Create Shaft"
		}
		"019105FA82C64A93": {
			description: "Craft a brass casing — Create's housing component. This casing is used in BOTH Create machines AND Mekanism's energy cubes."
			name: "Brass Casing"
		}
		"019105FA82C64A94": {
			description: "Craft a steel casing — Mekanism's machine housing. This casing is used in BOTH Mekanism machines AND Create's precision mechanisms."
			name: "Steel Casing"
		}
		"019105FA82C64A95": {
			description: "You now have access to all three tech trees! Create for kinetic power, Mekanism for machines, and AE2 for digital storage."
			name: "Tech Foundations"
		}
		"C3D4E5F607182002": {
			description: "Craft 4 shafts. Create shafts transfer rotational power AND serve as components in Mekanism's wind turbines and AE2's energy cables."
			name: "Create Shafts"
		}
		"C3D4E5F607182003": {
			description: "Build a water wheel for passive kinetic power. This same rotational force powers Create factories AND can feed energy into Mekanism's energy cubes."
			name: "Water Wheel"
		}
		"C3D4E5F607182004": {
			description: "Craft a mechanical press. This press doubles as a Mekanism enrichment chamber alternative for ore processing."
