{ config, lib, pkgs, flake, ... }:
let
  cfg = config.my.programs.riotGames;
  inherit (flake.config.me) username;

  bootEntry = cfg.windows.bootEntry;

  # ── Root helper: arm a one-shot GRUB entry for Windows, then reboot ──────
  # `grub-reboot` writes `next_entry` into /boot/grub/grubenv (root-owned,
  # consumed once by the grub.cfg generated by NixOS). It is preferred over
  # `efibootmgr --bootnext` because it names the entry the same way the GRUB
  # menu does and leaves the permanent EFI boot order untouched.
  bootToWindows = pkgs.writeShellScriptBin "boot-to-windows" ''
    set -eu

    ENTRY=${lib.escapeShellArg bootEntry}
    GRUB_CFG=/boot/grub/grub.cfg

    if [ ! -r "$GRUB_CFG" ]; then
      echo "boot-to-windows: cannot read $GRUB_CFG (is this a GRUB host?)" >&2
      exit 1
    fi

    if ! grep -qF "menuentry \"$ENTRY\"" "$GRUB_CFG"; then
      echo "boot-to-windows: no 'menuentry \"$ENTRY\"' in $GRUB_CFG" >&2
      echo "Fix my.programs.riotGames.windows.bootEntry (the GRUB menu title)." >&2
      exit 1
    fi

    ${lib.getExe' pkgs.grub2 "grub-reboot"} "$ENTRY"
    echo "GRUB next boot: $ENTRY — rebooting."
    exec ${config.systemd.package}/bin/systemctl reboot
  '';

  # ── User helper: confirm in a GUI, then invoke the root helper ───────────
  # The confirmation lives *outside* sudo on purpose: a reboot click is
  # destructive, and zenity cannot reach the Wayland session as root.
  rebootToWindowsGui = pkgs.writeShellScriptBin "riot-reboot-to-windows" ''
    set -eu

    if [ "''${1:-}" != "--no-confirm" ]; then
      ${lib.getExe' pkgs.zenity "zenity"} --question \
        --title="Reboot to Windows" \
        --text="League of Legends and Teamfight Tactics cannot run on Linux — Riot Vanguard is a Windows kernel driver.\n\nSet a one-shot GRUB entry and reboot into Windows now?" \
        --ok-label="Reboot to Windows" \
        --cancel-label="Cancel" || exit 0
    fi

    exec ${config.security.sudo.package}/bin/sudo -n ${bootToWindows}/bin/boot-to-windows
  '';

  # ── User helper: mirror the Android TFT client over scrcpy ───────────────
  tftMobile = pkgs.writeShellScriptBin "tft-mobile" ''
    set -eu

    ADB=${lib.getExe' pkgs.android-tools "adb"}
    SCRCPY=${lib.getExe' pkgs.scrcpy "scrcpy"}
    SCRCPY_ARGS=(
      "--max-size=${toString cfg.mobileMirror.maxSize}"
      "--max-fps=${toString cfg.mobileMirror.maxFps}"
      ${lib.escapeShellArgs cfg.mobileMirror.extraArgs}
    )

    usage() {
      echo "Usage:"
      echo "  tft-mobile                        mirror a device adb can already reach"
      echo "  tft-mobile <ip:port>              connect over Wi-Fi, then mirror"
      echo "  tft-mobile --pair <ip:port> <PIN> one-time wireless-debugging pairing"
      echo "  tft-mobile --stop                 stop the adb server"
      echo ""
      echo "Enable Developer options → Wireless debugging on the phone to get the"
      echo "address and pairing code. TFT runs on the phone; scrcpy only mirrors it."
    }

    case "''${1:-}" in
      -h | --help)
        usage
        exit 0
        ;;
      --pair)
        shift
        if [ "$#" -ne 2 ]; then
          usage
          exit 1
        fi
        exec "$ADB" pair "$1" "$2"
        ;;
      --stop)
        exec "$ADB" kill-server
        ;;
      "")
        exec "$SCRCPY" "''${SCRCPY_ARGS[@]}"
        ;;
      *)
        exec "$SCRCPY" --tcpip="$1" "''${SCRCPY_ARGS[@]}"
        ;;
    esac
  '';

  mkWindowsEntry = attrs: {
    exec = "${rebootToWindowsGui}/bin/riot-reboot-to-windows";
    icon = "applications-games";
    categories = [ "Game" ];
    terminal = false;
    comment = "Cannot run on Linux (Riot Vanguard). Reboots into Windows.";
  } // attrs;
in
{
  config = lib.mkIf cfg.enable {
    # The launcher needs GRUB + an existing Windows menu entry; tests.nix
    # asserts both so a misconfigured host fails at eval instead of at the
    # moment someone clicks the entry.
    environment.systemPackages = [ bootToWindows ] ++ cfg.extraPackages;

    # Narrow NOPASSWD rule: only the store script, only its owner. grubenv is
    # root-owned with mode 0077 on this layout, so this cannot be done unprivileged.
    security.sudo.extraRules = [
      {
        users = [ username ];
        commands = [
          {
            command = "${bootToWindows}/bin/boot-to-windows";
            options = [ "NOPASSWD" ];
          }
        ];
      }
    ];

    home-manager.users.${username} = {
      home.packages = [ rebootToWindowsGui ]
        ++ lib.optionals cfg.mobileMirror.enable [ tftMobile ];

      xdg.desktopEntries = lib.mkMerge [
        (lib.mkIf cfg.leagueOfLegends.enable {
          league-of-legends = mkWindowsEntry {
            name = "League of Legends (reboot to Windows)";
          };
        })
        (lib.mkIf cfg.teamfightTactics.enable {
          teamfight-tactics = mkWindowsEntry {
            name = "Teamfight Tactics (reboot to Windows)";
          };
        })
        (lib.mkIf cfg.mobileMirror.enable {
          teamfight-tactics-mobile = {
            name = "Teamfight Tactics (Android mirror)";
            exec = "${tftMobile}/bin/tft-mobile";
            icon = "applications-games";
            categories = [ "Game" ];
            terminal = true;
            comment = "Mirror the Android TFT client over scrcpy (the only working TFT route on Linux)";
          };
        })
      ];
    };
  };
}
