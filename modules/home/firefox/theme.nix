# Firefox theming — opt-in userChrome/userContent styles from the palette.
#
# Default OFF: Mozilla does not support userChrome.css, and a bad rule is more
# visible than no theme. With `theme.enable = false` (the default) stylix's
# firefox target keeps owning the browser theme; enabling this hands ownership
# to this file and the stylix target is disabled for that host.
{ config, lib, ... }:

let
  cfg = config.my.programs.firefox;
  themeLib = import ../../../lib/theme.nix { inherit lib; };
  t = cfg.theme;
  p = t.palette;

  # `:root { --theme-… }` — also used by userContent.css for the variables.
  vars = themeLib.cssVars { palette = p; };

  userChrome = ''
    /* Generated by modules/home/firefox/theme.nix — do not edit. */
    ${vars}

    #navigator-toolbox,
    #TabsToolbar,
    #PersonalToolbar {
      background-color: var(--theme-background) !important;
      color: var(--theme-foreground) !important;
    }

    #nav-bar {
      background-color: var(--theme-surface) !important;
      color: var(--theme-foreground) !important;
    }

    #urlbar-background,
    #searchbar {
      background-color: var(--theme-surface) !important;
      border-color: var(--theme-border) !important;
    }

    #urlbar:is([focused], [open]) > #urlbar-background {
      border-color: var(--theme-accent) !important;
    }

    .tab-background[selected="true"] {
      background-color: var(--theme-background-element) !important;
      border-color: var(--theme-accent) !important;
    }

    .tabbrowser-tab:hover > .tab-stack > .tab-background:not([selected="true"]) {
      background-color: var(--theme-surface) !important;
    }

    #sidebar-box,
    #sidebar-header {
      background-color: var(--theme-surface) !important;
      color: var(--theme-foreground) !important;
    }

    menupopup,
    panel {
      --panel-background: var(--theme-surface) !important;
      --panel-color: var(--theme-foreground) !important;
    }
  '';

  userContent = ''
    /* Generated by modules/home/firefox/theme.nix — do not edit. */
    ${vars}

    @-moz-document url-prefix("about:") {
      :root {
        background-color: var(--theme-background) !important;
        color: var(--theme-foreground) !important;
      }

      a {
        color: var(--theme-accent) !important;
      }
    }
  '';
in
{
  # Declared here, not in options.nix: all theming lives in one file.
  options.my.programs.firefox.theme = themeLib.mkAppTheme {
    base = config.my.theming.colors;
    defaultEnable = false;
  };

  config = lib.mkIf (cfg.enable && t.enable) {
    programs.firefox.profiles.${cfg.username} = {
      # Required for any userChrome/userContent.css to load.
      settings."toolkit.legacyUserProfileCustomizations.stylesheets" = true;
      inherit userChrome userContent;
    };
  };
}
