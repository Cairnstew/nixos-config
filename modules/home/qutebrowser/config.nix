{ config, lib, pkgs, ... }:
let
  inherit (lib) mkIf;
  cfg = config.my.programs.qutebrowser;

  sharedPy = import ./lib.nix {
    inherit lib;
    onePassword = cfg.onePassword.enable;
    keybinding = cfg.onePassword.keybinding;
    googleUserAgent =
      if cfg.googleSignInFix.enable then cfg.googleSignInFix.userAgent else null;
  };
in
{
  config = mkIf cfg.enable {

    home.packages = [ pkgs.qutebrowser ]
      ++ lib.optionals cfg.onePassword.enable [
      # 1Password userscript runtime deps: item picker + clipboard.
      # `op` comes from the system 1Password module (polkit/desktop-app wired).
      pkgs.wofi
      pkgs.wl-clipboard
    ];

    # Without --basedir, qutebrowser's config dir *is* ~/.config/qutebrowser, so
    # config.py belongs at its root (with --basedir it would be
    # <basedir>/config/config.py — see GOTCHAS.md).
    xdg.configFile."qutebrowser/config.py".text = ''
      # Generated by modules/home/qutebrowser/config.nix (home-manager).
      # This is a read-only symlink: edit the Nix module, and use autoconfig.yml
      # (via :set) for per-machine overrides. :config-write-py would replace
      # this file and break the symlink.
      config.load_autoconfig()

      ${sharedPy}

      # Generated palette (modules/home/qutebrowser/theme.nix).
      config.source("theme.py")
    '';

    # Userscripts are looked up in <config dir>/userscripts, i.e.
    # ~/.config/qutebrowser/userscripts for the default profile.
    xdg.configFile."qutebrowser/userscripts/qute-1pass.py" = mkIf cfg.onePassword.enable {
      source = ./userscripts/qute-1pass.py;
      executable = true;
    };

  };
}
