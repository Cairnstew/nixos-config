# qutebrowser theming — generated config.py fragment from the shared palette.
#
# qutebrowser is configured in Python (`c.colors.*`), and both the default
# profile and the squid-proxy profile load `~/.config/qutebrowser/theme.py`
# (the proxy profile sources it by absolute path), so one generated file themes
# both browsers.
{ config, lib, ... }:

let
  cfg = config.my.programs.qutebrowser;
  themeLib = import ../../../lib/theme.nix { inherit lib; };
  t = cfg.theme;
  p = t.palette;

  # Palette names matching qutebrowser's `c.colors.*` roles. The file is plain
  # Python: one `c.colors.… = …` statement per line.
  role = name: p.${name};

  lines = [
    "# Generated by modules/home/qutebrowser/theme.nix — do not edit."
    "# Scheme: ${p.slug} (${p.polarity})"

    "c.colors.webpage.bg = '${role "background"}'"
    "c.colors.webpage.preferred_color_scheme = '${p.polarity}'"
    "c.colors.webpage.darkmode.enabled = ${if p.polarity == "dark" then "True" else "False"}"

    # Completion
    "c.colors.completion.fg = ['${role "foreground"}', '${role "foreground"}', '${role "foreground"}']"
    "c.colors.completion.odd.bg = '${role "background"}'"
    "c.colors.completion.even.bg = '${role "surface"}'"
    "c.colors.completion.category.fg = '${role "accent"}'"
    "c.colors.completion.category.bg = '${role "surface"}'"
    "c.colors.completion.category.border.top = '${role "surface"}'"
    "c.colors.completion.category.border.bottom = '${role "surface"}'"
    "c.colors.completion.item.selected.fg = '${role "background"}'"
    "c.colors.completion.item.selected.bg = '${role "accent"}'"
    "c.colors.completion.item.selected.border.top = '${role "accent"}'"
    "c.colors.completion.item.selected.border.bottom = '${role "accent"}'"
    "c.colors.completion.match.fg = '${role "error"}'"
    "c.colors.completion.scrollbar.fg = '${role "border"}'"
    "c.colors.completion.scrollbar.bg = '${role "background"}'"

    # Context menu
    "c.colors.contextmenu.menu.fg = '${role "foreground"}'"
    "c.colors.contextmenu.menu.bg = '${role "surface"}'"
    "c.colors.contextmenu.disabled.fg = '${role "foregroundSubtle"}'"
    "c.colors.contextmenu.disabled.bg = '${role "surface"}'"
    "c.colors.contextmenu.selected.fg = '${role "background"}'"
    "c.colors.contextmenu.selected.bg = '${role "accent"}'"

    # Downloads
    "c.colors.downloads.bar.bg = '${role "background"}'"
    "c.colors.downloads.start.fg = '${role "background"}'"
    "c.colors.downloads.start.bg = '${role "accent"}'"
    "c.colors.downloads.stop.fg = '${role "background"}'"
    "c.colors.downloads.stop.bg = '${role "success"}'"
    "c.colors.downloads.error.fg = '${role "error"}'"
    "c.colors.downloads.error.bg = '${role "background"}'"

    # Hints
    "c.colors.hints.fg = '${role "background"}'"
    "c.colors.hints.bg = '${role "warning"}'"
    "c.colors.hints.match.fg = '${role "accent"}'"
    "c.colors.keyhint.fg = '${role "foreground"}'"
    "c.colors.keyhint.suffix.fg = '${role "warning"}'"
    "c.colors.keyhint.bg = '${role "background"}'"

    # Messages
    "c.colors.messages.error.fg = '${role "background"}'"
    "c.colors.messages.error.bg = '${role "error"}'"
    "c.colors.messages.error.border = '${role "error"}'"
    "c.colors.messages.warning.fg = '${role "background"}'"
    "c.colors.messages.warning.bg = '${role "warning"}'"
    "c.colors.messages.warning.border = '${role "warning"}'"
    "c.colors.messages.info.fg = '${role "background"}'"
    "c.colors.messages.info.bg = '${role "accent"}'"
    "c.colors.messages.info.border = '${role "accent"}'"

    # Prompts
    "c.colors.prompts.fg = '${role "foreground"}'"
    "c.colors.prompts.bg = '${role "surface"}'"
    "c.colors.prompts.selected.fg = '${role "background"}'"
    "c.colors.prompts.selected.bg = '${role "accent"}'"
    "c.colors.prompts.border = '1px solid ${role "border"}'"

    # Statusbar
    "c.colors.statusbar.normal.fg = '${role "foreground"}'"
    "c.colors.statusbar.normal.bg = '${role "background"}'"
    "c.colors.statusbar.command.fg = '${role "foreground"}'"
    "c.colors.statusbar.command.bg = '${role "surface"}'"
    "c.colors.statusbar.command.private.fg = '${role "foreground"}'"
    "c.colors.statusbar.command.private.bg = '${role "surface"}'"
    "c.colors.statusbar.insert.fg = '${role "background"}'"
    "c.colors.statusbar.insert.bg = '${role "success"}'"
    "c.colors.statusbar.passthrough.fg = '${role "background"}'"
    "c.colors.statusbar.passthrough.bg = '${role "accentAlt"}'"
    "c.colors.statusbar.private.fg = '${role "background"}'"
    "c.colors.statusbar.private.bg = '${role "surface"}'"
    "c.colors.statusbar.caret.fg = '${role "background"}'"
    "c.colors.statusbar.caret.bg = '${role "syntaxKeyword"}'"
    "c.colors.statusbar.caret.selection.fg = '${role "background"}'"
    "c.colors.statusbar.caret.selection.bg = '${role "accent"}'"
    "c.colors.statusbar.progress.bg = '${role "accent"}'"
    "c.colors.statusbar.url.fg = '${role "foreground"}'"
    "c.colors.statusbar.url.success.https.fg = '${role "success"}'"
    "c.colors.statusbar.url.success.http.fg = '${role "warning"}'"
    "c.colors.statusbar.url.error.fg = '${role "error"}'"
    "c.colors.statusbar.url.hover.fg = '${role "accent"}'"
    "c.colors.statusbar.url.warn.fg = '${role "warning"}'"

    # Tabs
    "c.colors.tabs.bar.bg = '${role "surface"}'"
    "c.colors.tabs.odd.fg = '${role "foreground"}'"
    "c.colors.tabs.odd.bg = '${role "surface"}'"
    "c.colors.tabs.even.fg = '${role "foreground"}'"
    "c.colors.tabs.even.bg = '${role "background"}'"
    "c.colors.tabs.selected.odd.fg = '${role "background"}'"
    "c.colors.tabs.selected.odd.bg = '${role "accent"}'"
    "c.colors.tabs.selected.even.fg = '${role "background"}'"
    "c.colors.tabs.selected.even.bg = '${role "accent"}'"
    "c.colors.tabs.indicator.start = '${role "accent"}'"
    "c.colors.tabs.indicator.stop = '${role "success"}'"
    "c.colors.tabs.indicator.error = '${role "error"}'"
    "c.colors.tabs.indicator.system = 'none'"

    # Cursor / selection in the webview
    "c.colors.webpage.darkmode.policy.images = 'never'"
  ];

  generated = lib.concatStringsSep "\n" lines + "\n";
in
{
  # Declared here, not in options.nix: all theming lives in one file.
  options.my.programs.qutebrowser.theme = themeLib.mkAppTheme {
    base = config.my.theming.colors;
  };

  config = {
    # Always written: the generated config.py sources it unconditionally, so an
    # empty file (theme disabled) must exist rather than fail to open.
    xdg.configFile."qutebrowser/theme.py".text = if t.enable then generated else "";
  };
}
