# Thunderbird theming — opt-in userChrome.css from the shared palette.
#
# Default OFF: Thunderbird does not support userChrome.css officially, and a
# bad rule is more visible than an unthemed client. Enable with
# `my.programs.thunderbird.theme.enable = true` (requires the legacy
# stylesheet pref, which this file sets).
{ config, lib, ... }:

let
  cfg = config.my.programs.thunderbird;
  themeLib = import ../../../lib/theme.nix { inherit lib; };
  t = cfg.theme;
  p = t.palette;

  vars = themeLib.cssVars { palette = p; };

  userChrome = ''
    /* Generated by modules/home/thunderbird/theme.nix — do not edit. */
    ${vars}

    #messengerWindow,
    #tabmail {
      background-color: var(--theme-background) !important;
      color: var(--theme-foreground) !important;
    }

    #toolbar-menubar,
    #navigation-toolbar,
    #tabbar-toolbar {
      background-color: var(--theme-background) !important;
      color: var(--theme-foreground) !important;
    }

    #folderTree,
    #threadTree {
      background-color: var(--theme-background) !important;
      color: var(--theme-foreground) !important;
    }

    #folderTree treechildren::-moz-tree-row(selected),
    #threadTree treechildren::-moz-tree-row(selected) {
      background-color: var(--theme-accent) !important;
      color: var(--theme-background) !important;
    }

    #messagepane {
      background-color: var(--theme-background) !important;
      color: var(--theme-foreground) !important;
    }

    #quick-filter-bar {
      background-color: var(--theme-surface) !important;
      color: var(--theme-foreground) !important;
    }

    menupopup,
    panel {
      --panel-background: var(--theme-surface) !important;
      --panel-color: var(--theme-foreground) !important;
    }
  '';
in
{
  # Declared here, not in options.nix: all theming lives in one file.
  options.my.programs.thunderbird.theme = themeLib.mkAppTheme {
    base = config.my.theming.colors;
    defaultEnable = false;
  };

  config = lib.mkIf (cfg.enable && t.enable) {
    programs.thunderbird.profiles.${cfg.profileName} = {
      settings."toolkit.legacyUserProfileCustomizations.stylesheets" = true;
      inherit userChrome;
    };
  };
}
